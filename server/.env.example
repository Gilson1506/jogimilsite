# Configuração do Microserviço de Email da JOGIMIL - Tecnologias, Lda.
PORT=3001
DESTINATION_EMAIL=geral@jogimiltecnologias.it.ao
FROM_EMAIL="JOGIMIL Tecnologias" <geral@jogimiltecnologias.it.ao>

# Servidor de Saída (SMTP - Angoweb) - Requer Autenticação SSL/TLS
SMTP_HOST=mx109.angoweb.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=geral@jogimiltecnologias.it.ao
SMTP_PASS=

# Servidor de Entrada (IMAP / POP3 - Angoweb) - Requer Autenticação SSL/TLS
IMAP_HOST=mx109.angoweb.net
IMAP_PORT=993
POP3_HOST=mx109.angoweb.net
POP3_PORT=995
